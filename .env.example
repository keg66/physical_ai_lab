# Copy this file to .env and set only the credentials you need.
# Never commit .env or real API keys.

# Google GenAI SDK accepts GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=

# Required by the hosted Jev examples.
TYPESAFE_API_KEY=

# Optional Jev overrides. The defaults used by the code are shown below.
TYPESAFE_SYSTEMONE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_SYSTEMONE_MODEL=jev-latest
